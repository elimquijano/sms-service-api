# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
REQUIRE_HTTPS=false
LOG_LEVEL=info
SERVICE_INSTANCE_ID=

# API HTTP: cliente:secreto (varios separados por coma)
# En producción usa secretos aleatorios de al menos 32 caracteres.
API_KEYS=cliente_demo:cambia-este-secreto-de-al-menos-32-caracteres

# Compatibilidad opcional con Basic Auth. API_KEYS es preferible.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Gateway Android. Debe ser un secreto distinto de las API keys.
WEBSOCKET_TOKEN=cambia-este-token-de-al-menos-32-caracteres
WEBSOCKET_ALLOWED_ORIGINS=

# Persistencia JSON durable
SMS_STATE_FILE=data/sms-state.json

# Validación y protección contra sobrecarga
DEFAULT_COUNTRY_CODE=+51
MAX_BODY_BYTES=262144
MAX_MESSAGE_LENGTH=300
MAX_RECIPIENTS_PER_REQUEST=500
MAX_QUEUE_SIZE=5000
MAX_QUEUED_MESSAGE_BYTES=5000000
IP_RATE_PER_MINUTE=300
REQUEST_RATE_PER_MINUTE=60
RECIPIENT_RATE_PER_MINUTE=1000
WS_MESSAGES_PER_MINUTE=240
WS_UPGRADE_RATE_PER_MINUTE=30

# Ritmo de envío y ráfagas
# AOSP permite por defecto 30/min para apps no predeterminadas. Se usa 20/min con margen.
ANDROID_SMS_RPM=20
SEND_INTERVAL_MS=1500
BURST_SIZE=10
BURST_PAUSE_MS=10000

# Confirmaciones, reconexión y reintentos
ACK_TIMEOUT_MS=30000
RECONNECT_RETRY_MS=3000
MAX_RETRIES=2
RETRY_BASE_MS=5000
RETRY_MAX_MS=30000
RETRY_FAILED_TASKS=true
MODEM_ERROR_PAUSE_MS=60000
NETWORK_ERROR_PAUSE_MS=30000
RATE_LIMIT_PAUSE_MS=120000
HEARTBEAT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000
RETENTION_DAYS=365
